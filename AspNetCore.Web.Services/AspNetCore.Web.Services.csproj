<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <AssemblyName>Core.Web.Services</AssemblyName>
        <RootNamespace>System.Web.Services</RootNamespace>
        <TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <NoWarn>$(NoWarn);168;612;618;649;436;1591;0108;0114;0067;0162;0169;0219;0414;3021;SYSLIB0003;SYSLIB0011;SYSLIB0012;SYSLIB0021;SYSLIB0022;SYSLIB0023;CS8981</NoWarn>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <WarningLevel>0</WarningLevel>
        <DebugType>portable</DebugType>
        <MonoServicesDir>$(MSBuildThisFileDirectory)..\mono\mcs\class\System.Web.Services\</MonoServicesDir>
        <DefineConstants>$(DefineConstants);NET_1_1;NET_2_0;NET_3_5;NET_4_0;NET_4_5;SYSTEM_WEB_PORT;MONO</DefineConstants>
        <DefineConstants>$(DefineConstants);MONO_BROKEN_CONFIGURATION_DLL</DefineConstants>
        <PackageId>AspNet$(AssemblyName)</PackageId>
        <Description>ASP.NET .asmx web services on .NET 10 - SOAP and JSON [WebMethod] endpoints, ?wsdl and the help page. Serving only; WSDL client-proxy generation is not available on .NET.</Description>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="..\AspNetCore.Web\AspNetCore.Web.csproj" />
    </ItemGroup>
    <Import Project="Sources.generated.props" />
    <ItemGroup>
        <Compile Include="Generated\**\*.cs" />
        <Compile Include="Port\**\*.cs" />
        <Compile Include="Overrides\**\*.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Mono embeds these with explicit names (-resource:path,name); WSDL generation reads them back
         by that name, so the LogicalName must match exactly. -->
        <EmbeddedResource Include="$(MonoServicesDir)System.Web.Services.Description\wsdl-1.1.xsd" LogicalName="wsdl-1.1.xsd" />
        <EmbeddedResource Include="$(MonoServicesDir)System.Web.Services.Description\wsdl-1.1-soap.xsd" LogicalName="wsdl-1.1-soap.xsd" />
        <EmbeddedResource Include="$(MonoServicesDir)System.Web.Services.Description\web-reference.xsd" LogicalName="web-reference.xsd" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
    </ItemGroup>
    <Import Project="..\build\WebFormsPort.targets" />
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <!-- Travels with the package: an SPDX expression says WHICH licences apply, not to which
             files. See Directory.Build.props for why the expression is set explicitly. -->
        <Content Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\THIRD-PARTY-NOTICES.md" />
    </ItemGroup>
</Project>