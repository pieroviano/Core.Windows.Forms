<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props" Condition="Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.props')" />
    <!--
    System.Web.WebPages.Deployment - decides which WebPages version an application binds to, and is
    what makes a bare .cshtml servable at all. Small, but load-bearing: WebPageRoute asks it whether
    WebPages is enabled for the site before it will route anything.
  -->
    <PropertyGroup>
        <!-- Every port assembly is packable, like the rest of the port. -->
        <PackageOutputPath>$(SolutionDir)Packages/</PackageOutputPath>
        <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
        <Version>$(VersionPrefix).$(VersionSuffix)</Version>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Core.Web.WebPages.Deployment</AssemblyName>
        <RootNamespace>System.Web.WebPages.Deployment</RootNamespace>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
        <NoWarn>$(NoWarn);612;618;436;1591;0108;0114;0067;0162;0169;0219;0414;0649;3021;SYSLIB0003;SYSLIB0011;SYSLIB0012;SYSLIB0021;SYSLIB0022;SYSLIB0023;CS8981</NoWarn>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <WarningLevel>0</WarningLevel>
        <DebugType>portable</DebugType>
        <AspNetWebStackDir>$(MSBuildThisFileDirectory)..\Mono\external\aspnetwebstack\src\</AspNetWebStackDir>
        <DefineConstants>$(DefineConstants);ASPNETWEBPAGES</DefineConstants>
        <DefineConstants>$(DefineConstants);NET_4_0;NET_4_5;MONO;SYSTEM_WEB_PORT</DefineConstants>
        <PackageId>AspNet$(AssemblyName)</PackageId>
        <Description>Web Pages version resolution and deployment support. Arrives with AspNetCore.Web.WebPages.Base; you do not reference it directly.</Description>
        <!-- Apache-2.0 for the aspnetwebstack sources this compiles, MIT for Mono's AssemblyInfo.cs and
             this port's own code. See Directory.Build.props for why the expression must be explicit. -->
        <PortLicenseExpression>Apache-2.0 AND MIT</PortLicenseExpression>
    </PropertyGroup>
    <!-- Upstream sources, compiled in place. Regenerate with: Tools/gen-sources.ps1 -->
    <Import Project="Sources.generated.props" />
    <ItemGroup>
        <Compile Include="Generated\**\*.cs" />
        <Compile Include="Overrides\**\*.cs" />
        <Compile Include="Port\**\*.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- Upstream declares these manifest names explicitly (Makefile RESOURCE_DEFS) and the
         generated Designer classes look them up at runtime. A wrong name surfaces as a
         MissingManifestResourceException the first time an error message is formatted. -->
        <EmbeddedResource Include="$(AspNetWebStackDir)CommonResources.resx" LogicalName="System.Web.WebPages.Deployment.Common.CommonResources.resources" />
        <EmbeddedResource Include="$(AspNetWebStackDir)System.Web.WebPages.Deployment\Resources\ConfigurationResources.resx" LogicalName="System.Web.WebPages.Deployment.Resources.ConfigurationResources.resources" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Net4x.NuGetUtility" Version="$(NuGetUtilityVersion)" PrivateAssets="All" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\AspNetCore.Web\AspNetCore.Web.csproj" />
        <ProjectReference Include="..\AspNetCore.Web.Infrastructure\AspNetCore.Web.Infrastructure.csproj" />
    </ItemGroup>
    <!-- Removes the empty .NET System.Web.dll facade; see the file for why this is not optional. -->
    <PropertyGroup>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>
    <ItemGroup>
        <Content Include="README.md" Link="README.md" Pack="true" PackagePath="\README.md" />
        <!-- Travels with the package: an SPDX expression says WHICH licences apply, not to which
             files. See Directory.Build.props for why the expression is set explicitly. -->
        <Content Include="$(MSBuildThisFileDirectory)..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\THIRD-PARTY-NOTICES.md" />
    </ItemGroup>
    <Import Project="..\Build\WebFormsPort.targets" />
    <Import Project="$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets" Condition="Exists('$(NuGetPackageRoot)net4x.nugetutility/$(NuGetUtilityVersion)/build/NuGet.Utility.targets')" />
</Project>