<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" />
    <customErrors mode="Off" />

    <!--
      The whole point of the sample: an application that says StateServer, unchanged from what it
      would have said under IIS. Nothing here names a cache, a Redis endpoint or a provider type -
      the host supplies the backing store through UseWebFormsSessionState, and this file stays as the
      migration found it.
    -->
    <sessionState mode="StateServer"
                  stateConnectionString="tcpip=127.0.0.1:42424"
                  cookieless="false"
                  timeout="20" />
  </system.web>
</configuration>
