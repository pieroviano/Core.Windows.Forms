<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- What the MVC 4 project template writes, and not optional: without it Web Pages' route claims
         every .cshtml under the application - including /Views/Home/Index.cshtml requested directly -
         and fails with "does not inherit from WebPage" (a 500) instead of Views/web.config's 404. MVC
         renders its views through its own view engine and does not need the Web Pages route at all. -->
    <add key="webpages:Enabled" value="false" />
  </appSettings>
  <system.web>
    <compilation debug="true">
      <!-- What makes a .cshtml compilable at all: BuildManager hands the file to this provider, which
           runs it through Razor and then the Roslyn backend. Without it a view request 404s. -->
      <buildProviders>
        <add extension=".cshtml" type="System.Web.WebPages.Razor.RazorBuildProvider, Core.Web.WebPages.Razor" />
      </buildProviders>
      <!-- Referenced by every compiled view. These name the PORT's assemblies (Core.*), not
           System.Web.Mvc - see PORTING-GUIDE.md on assembly renaming. -->
      <assemblies>
        <add assembly="Core.Web.Mvc" />
        <add assembly="Core.Web.WebPages" />
        <add assembly="Core.Web.WebPages.Razor" />
        <add assembly="Core.Web.Razor" />
        <!-- The application's OWN assembly. MVC's DefaultControllerFactory finds controllers by
             scanning BuildManager.GetReferencedAssemblies (), which is this list - not the set of
             loaded assemblies - so without it every route resolves and then fails with "The
             controller for path '/...' was not found or does not implement IController". -->
        <add assembly="MvcSample" />
      </assemblies>
    </compilation>
    <customErrors mode="Off" />
    <httpModules>
      <!-- Matches RouteTable.Routes and dispatches to MvcHandler. -->
      <add name="UrlRoutingModule" type="System.Web.Routing.UrlRoutingModule" />
    </httpModules>
  </system.web>
</configuration>
