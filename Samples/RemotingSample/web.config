<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" />
    <customErrors mode="Off" />

    <!-- Served by a remote state server because Program.cs calls UseWebFormsRemoteStateServer. The
         connection string is the one aspnet_state.exe clients always used. -->
    <sessionState mode="StateServer"
                  stateConnectionString="tcpip=127.0.0.1:42424"
                  cookieless="false"
                  timeout="20" />
  </system.web>

  <!-- As it was written for IIS: an http channel with no port, which the web server hooks, and the
       objects published below the application's url - http://host/Calculator.rem. -->
  <system.runtime.remoting>
    <application>
      <service>
        <wellknown mode="Singleton" type="RemotingSample.Calculator, RemotingSample" objectUri="Calculator.rem" />
        <activated type="RemotingSample.Counter, RemotingSample" />
      </service>
      <channels>
        <channel ref="http" />
      </channels>
    </application>
  </system.runtime.remoting>
</configuration>
