<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <sectionGroup name="system.web.webPages.razor" type="System.Web.WebPages.Razor.Configuration.RazorWebSectionGroup, Core.Web.WebPages.Razor">
      <section name="host" type="System.Web.WebPages.Razor.Configuration.HostSection, Core.Web.WebPages.Razor" requirePermission="false" />
      <section name="pages" type="System.Web.WebPages.Razor.Configuration.RazorPagesSection, Core.Web.WebPages.Razor" requirePermission="false" />
    </sectionGroup>
  </configSections>

  <!-- No factoryType here, unlike an MVC application: a standalone page uses the default Web Pages
       host, and its base type is WebPage rather than MVC's WebViewPage. -->
  <system.web.webPages.razor>
    <pages pageBaseType="System.Web.WebPages.WebPage">
      <namespaces>
        <add namespace="System.Web.WebPages" />
        <add namespace="System.Web.WebPages.Html" />
      </namespaces>
    </pages>
  </system.web.webPages.razor>

  <appSettings>
    <!-- WebPagesDeployment reads this to decide whether Web Pages is enabled for the site. Without it
         the decision falls back to "is there a .cshtml in the app root", which is true here anyway -
         but stating it makes the sample's intent explicit. -->
    <add key="webPages:Enabled" value="true" />
    <add key="site.name" value="Web Pages on Kestrel" />
  </appSettings>

  <system.web>
    <compilation debug="true">
      <buildProviders>
        <add extension=".cshtml" type="System.Web.WebPages.Razor.RazorBuildProvider, Core.Web.WebPages.Razor" />
      </buildProviders>
      <assemblies>
        <add assembly="Core.Web.WebPages" />
        <add assembly="Core.Web.WebPages.Razor" />
        <add assembly="Core.Web.Razor" />
      </assemblies>
    </compilation>
    <customErrors mode="Off" />
  </system.web>
</configuration>
