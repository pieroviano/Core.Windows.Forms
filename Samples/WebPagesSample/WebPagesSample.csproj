<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The package ships these in its build/ folder and NuGet imports them automatically for a
       PackageReference. These samples use a ProjectReference instead, which carries no build/ assets,
       so they are imported by hand to get the same result: the content globs, App_Code handling and
       code-behind nesting that every ported project would otherwise repeat. -->
  <Import Project="..\..\AspNetCore.Web.Hosting.Kestrel\build\Core.Web.Hosting.Kestrel.props" />

  <!--
    ASP.NET Web Pages: standalone .cshtml files served directly, with no controller and no route
    table. WebPageHttpModule registers itself through a PreApplicationStartMethod on Core.Web.WebPages
    and maps the request to the matching file.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AspNetCore.Web.Hosting.Kestrel\AspNetCore.Web.Hosting.Kestrel.csproj" />
    <ProjectReference Include="..\..\AspNetCore.Web.WebPages\AspNetCore.Web.WebPages.csproj" />
    <ProjectReference Include="..\..\AspNetCore.Web.WebPages.Razor\AspNetCore.Web.WebPages.Razor.csproj" />
  </ItemGroup>

  <Import Project="..\..\Build\WebFormsPort.targets" />

  <Import Project="..\..\AspNetCore.Web.Hosting.Kestrel\build\Core.Web.Hosting.Kestrel.targets" />

</Project>
