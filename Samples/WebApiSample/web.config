<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true">
      <assemblies>
        <add assembly="Core.Web.Http" />
        <add assembly="Core.Web.Http.WebHost" />
        <add assembly="Core.Net.Http.Formatting" />
        <!-- The application's own assembly: Web API discovers controllers by scanning
             BuildManager.GetReferencedAssemblies (), the same way MVC does. -->
        <add assembly="WebApiSample" />
      </assemblies>
    </compilation>
    <customErrors mode="Off" />
    <httpModules>
      <add name="UrlRoutingModule" type="System.Web.Routing.UrlRoutingModule" />
    </httpModules>
  </system.web>
</configuration>
