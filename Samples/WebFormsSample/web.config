<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Read back through a library compiled against the real ConfigurationManager package, to prove
       the facade routes third-party configuration reads at web.config. -->
  <appSettings>
    <add key="probe.setting" value="seen-by-third-party-library" />
  </appSettings>
  <connectionStrings>
    <add name="ProbeDb" connectionString="Server=.;Database=probe" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" defaultLanguage="c#" />
    <customErrors mode="Off" />
    <!-- SiteMap provider reading Web.sitemap - the default provider registration comes from
         machine.config; this just confirms the section round-trips. -->
    <siteMap defaultProvider="AspNetXmlSiteMapProvider" enabled="true" />
    <!-- Forms auth with an explicit loginUrl; the root stays anonymous, Secure/ denies '?'. -->
    <authentication mode="Forms">
      <forms name=".WEBFORMSAUTH" loginUrl="Login.aspx" protection="All" timeout="30" path="/" />
    </authentication>
    <httpModules>
      <add name="TraceModule" type="WebFormsSample.TraceModule, WebFormsSample" />
    </httpModules>
    <httpHandlers>
      <!-- M2 gate: a hand-written IHttpHandler, resolved through System.Web's own handler
           mapping, proving the config system and the Kestrel bridge both work end to end.
           The type lives in this application's own assembly. -->
      <add path="hello.hello" verb="*" type="WebFormsSample.HelloHandler, WebFormsSample" validate="false" />
    </httpHandlers>
  </system.web>
  <!-- The AJAX authentication service: a built-in [ScriptService] at
       /Authentication_JSON_AppService.axd that lets client script log in and out without a postback.
       Off by default, as upstream - enabling it is what routes the .axd to ScriptHandlerFactory. -->
  <system.web.extensions>
    <scripting>
      <webServices>
        <authenticationService enabled="true" requireSSL="false" />
      </webServices>
    </scripting>
  </system.web.extensions>
</configuration>
