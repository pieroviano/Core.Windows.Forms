<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="site.name" value="VB WebForms on Kestrel" />
  </appSettings>
  <system.web>
    <!-- defaultLanguage="vb" makes VB the compiler for pages with no Language= directive, and for
         App_Code. This is the one setting that switches the whole site's language. -->
    <compilation debug="true" defaultLanguage="vb" strict="false" explicit="true" />
    <customErrors mode="Off" />
    <authentication mode="Forms">
      <forms name=".VBWEBFORMSAUTH" loginUrl="Login.aspx" protection="All" timeout="30" path="/" />
    </authentication>
  </system.web>
</configuration>
