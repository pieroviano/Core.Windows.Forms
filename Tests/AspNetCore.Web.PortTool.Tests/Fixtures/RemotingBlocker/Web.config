<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" />
  </system.web>
  <system.runtime.remoting>
    <application>
      <service>
        <wellknown mode="Singleton" type="LegacyRemoting.Calculator, LegacyRemoting" objectUri="Calculator.rem" />
      </service>
    </application>
  </system.runtime.remoting>
</configuration>
