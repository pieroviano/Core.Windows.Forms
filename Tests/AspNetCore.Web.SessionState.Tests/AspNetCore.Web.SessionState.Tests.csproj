<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Functional tests for out-of-process session state, against Samples/SessionStateSample.

    The sample is configured mode="StateServer", so the StateServer suite runs everywhere with the
    in-memory IDistributedCache and needs no infrastructure at all. The SQL Server suite drives
    SqlSessionStateStore directly - it cannot drive it over HTTP, because one process hosts one
    application and that application has already declared its mode - and skips with a reason when no
    SQL Server is reachable.

    Its own project because the ported runtime hosts one application per process, and because
    SessionStateHostServices is frozen the first time a store is built: a second application could not
    be given different services afterwards.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WebFormsPort.SessionStateTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <!-- Microsoft.Data.SqlClient arrives through Core.Web.SessionState and requires 9.x. -->
    <WebFormsPortConfigurationManagerVersion>9.0.11</WebFormsPortConfigurationManagerVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AspNetCore.Web.Hosting.Kestrel\AspNetCore.Web.Hosting.Kestrel.csproj" />
    <ProjectReference Include="..\..\Samples\SessionStateSample\SessionStateSample.csproj" />
      <ProjectReference Include="..\..\AspNetCore.Web.SessionState\AspNetCore.Web.SessionState.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AspNetCore.Web.FunctionalTests\Infrastructure\RepoPaths.cs" Link="Infrastructure\RepoPaths.cs" />
  </ItemGroup>

  <Import Project="..\..\Build\WebFormsPort.targets" />

</Project>
