<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Functional tests for ASP.NET Web API on the port, against Samples/WebApiSample.

    HTTP rather than a browser: a Web API surface IS its HTTP contract - status codes, content
    negotiation, request and response bodies - and a browser would only obscure that.

    Its own project because the ported runtime hosts one application per process.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WebFormsPort.WebApiTests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AspNetCore.Web.Hosting.Kestrel\AspNetCore.Web.Hosting.Kestrel.csproj" />
    <ProjectReference Include="..\..\AspNetCore.Web.Http.WebHost\AspNetCore.Web.Http.WebHost.csproj" />
    <!-- Do not remove: the tests name System.Web.Http types directly. -->
    <ProjectReference Include="..\..\AspNetCore.Web.Http\AspNetCore.Web.Http.csproj" />
    <ProjectReference Include="..\..\Samples\WebApiSample\WebApiSample.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\AspNetCore.Web.FunctionalTests\Infrastructure\RepoPaths.cs" Link="Infrastructure\RepoPaths.cs" />
  </ItemGroup>

  <Import Project="..\..\Build\WebFormsPort.targets" />

</Project>
