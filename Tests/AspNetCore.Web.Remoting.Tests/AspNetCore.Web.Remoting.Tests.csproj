<Project Sdk="Microsoft.NET.Sdk">

	<!--
    Functional tests for Core.Web.Remoting, against Samples/RemotingSample.

      HttpRemotingTests         *.rem over a real Kestrel, called from a child domain (another process)
      RemoteStateServerTests    mode="StateServer" against Tools/state-server running as its own process
      ApplicationHostTests      ApplicationHost.CreateApplicationHost and ApplicationManager
      WebFormsApplicationsTests several applications in child domains behind one Kestrel, and recycling

    Its own project because the ported runtime hosts one application per process: the sample is that
    application here, and every other application these tests start runs in a child process.
  -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>WebFormsPort.RemotingTests</RootNamespace>
		<LangVersion>latest</LangVersion>
		<Nullable>disable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPackable>false</IsPackable>
		<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<NoWarn>$(NoWarn);CS8002;SYSLIB0010;CS0672</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\AspNetCore.Web.Hosting.Kestrel\AspNetCore.Web.Hosting.Kestrel.csproj" />
		<ProjectReference Include="..\..\AspNetCore.Web.Remoting\AspNetCore.Web.Remoting.csproj" />
		<ProjectReference Include="..\..\Samples\RemotingSample\RemotingSample.csproj" />
		<!-- Build ordering only: the state server is launched as a process, never loaded here. -->
		<ProjectReference Include="..\..\Tools\state-server\state-server.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\AspNetCore.Web.FunctionalTests\Infrastructure\RepoPaths.cs" Link="Infrastructure\RepoPaths.cs" />
	</ItemGroup>

	<Import Project="..\..\Build\WebFormsPort.targets" />

</Project>
