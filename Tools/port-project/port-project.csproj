<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Converts a legacy ASP.NET project to this port, per PORTING-GUIDE.md.

    Deliberately takes NO reference on the port itself. It reads and writes XML and text and never
    touches a System.Web type; referencing Core.Web would drag WebFormsPort.targets and the facade
    removal into a tool that has no use for either.

    Not packed as a dotnet tool: this is run once per application, and "dotnet run" against the project
    is how the guide already invokes Tools/verify-config.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>port-project</AssemblyName>
    <RootNamespace>PortProject</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tests drive Planner/PlanExecutor directly rather than shelling out to the built exe:
         calling the API is what lets a test assert that a dry run and an applied run produce the SAME
         plan object, which is the one invariant holding the two modes together. -->
    <InternalsVisibleTo Include="AspNetCore.Web.PortTool.Tests" Key="" />
  </ItemGroup>

</Project>
